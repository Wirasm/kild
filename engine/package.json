{
  "name": "kild-engine",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "kild engine — the agent runtime, daemon, and CLI.",
  "bin": {
    "kild": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "serve": "bun run src/server.ts",
    "cli": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "compile": "bun build --compile --minify --target=bun-darwin-arm64 src/server.ts --outfile dist/kild-engine"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "hono": "^4.8.3",
    "just-bash": "^3.0.1",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
